# Copie para .env e preencha. O .env nunca vai para o GitHub.
APP_ENV=development
DRY_RUN=true
WEBHOOK_SECRET=troque-por-um-segredo
REQUEST_TIMEOUT_SECONDS=20

# Pipefy
PIPEFY_API_URL=https://api.pipefy.com/graphql
PIPEFY_TOKEN=cole_seu_token_aqui
PIPEFY_PIPE_ID=ID_DO_SEU_PIPE
PIPEFY_PHASE_ID=

# IDs dos campos do formulario inicial do Pipefy (descubra pelo GraphQL Explorer)
PIPEFY_FIELD_ID_NOME=
PIPEFY_FIELD_ID_EMAIL=
PIPEFY_FIELD_ID_TELEFONE=
PIPEFY_FIELD_ID_EMPRESA=
PIPEFY_FIELD_ID_DORES=
PIPEFY_FIELD_ID_ORIGEM=
PIPEFY_FIELD_ID_RESUMO_COMERCIAL=
PIPEFY_FIELD_ID_LANDING_PAGE=
PIPEFY_FIELD_ID_TAGS=
